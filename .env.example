# Paper only. Never commit real keys. Never put live Alpaca keys here.

ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Market data (reads only). Never put live trading keys in this repo.
ALPACA_DATA_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# Optional thesis LLM. Loop still runs on modelSkip.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Caps how many tape names one scan scores (default 15).
LOOP_MAX_NAMES=15

# Unattended door. Default off = print MCP JSON only. Set true to send the
# same mleg payload to paper-api.markets. Model never places. Paper keys only.
LOOP_SEND=false
# Fat-finger ceiling on unattended qty. Governor still sizes 1% of equity.
# 12 does not clip typical 1% verticals; blocks a units bug (45-lot).
LOOP_MAX_QTY=12
